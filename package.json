{
  "name": "bytefall-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Symbol-graphics editor: draw with font glyphs on a cell grid, with layers, objects, animation and effects.",
  "keywords": [
    "ascii-art",
    "text-mode",
    "pixel-art",
    "editor",
    "animation",
    "webgl",
    "three-js"
  ],
  "license": "MIT",
  "author": "vLadder",
  "homepage": "https://github.com/T4rnum/bytefall-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T4rnum/bytefall-editor.git"
  },
  "bugs": {
    "url": "https://github.com/T4rnum/bytefall-editor/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && vite build"
  },
  "dependencies": {
    "browser-fs-access": "^0.38.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
